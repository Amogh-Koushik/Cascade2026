# Copy this file to .env and change values only if you need to. .env is git-ignored.
# Every setting has a working default, so .env is optional.

# Local Ollama model used by every agent (persona, coach, red-team).
PRATIBIMB_MODEL=qwen2.5:14b

# Where the Ollama server listens.
OLLAMA_HOST_URL=http://localhost:11434

# Folder the edge server serves twin_params_<persona>.json files from.
PRATIBIMB_PARAMS_DIR=contracts/params
