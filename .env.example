# Copy this file to .env and fill in what you need. .env is git-ignored; never commit a key.
# Commands that need these values run with: uv run --env-file .env python -m ...

# Which model backend the laptop-side agents use: "ollama" (local) or "gemini" (hosted).
PRATIBIMB_LLM=ollama

# Ollama: local model and where the server listens.
PRATIBIMB_MODEL=qwen2.5:14b
OLLAMA_HOST_URL=http://localhost:11434

# Gemini: key from aistudio.google.com (free tier works) and the model to use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Folder the edge server serves twin_params_<persona>.json files from.
PRATIBIMB_PARAMS_DIR=contracts/params
